def fizz_buzz_logic(start, end):
    fizz_count = 0
    buzz_count = 0
    fizzbuzz_count = 0

    for num in range(start, end + 1):
        if num % 3 == 0 and num % 5 == 0:
            print("FizzBuzz")
            fizzbuzz_count += 1
        elif num % 3 == 0:
            print("Fizz")
            fizz_count += 1
        elif num % 5 == 0:
            print("Buzz")
            buzz_count += 1
        else:
            print(num)

    return fizz_count, buzz_count, fizzbuzz_count


# Function call
fizz, buzz, fizzbuzz = fizz_buzz_logic(1, 50)

# Displaying results
print("\n--- Occurrence Count ---")
print("Fizz count:", fizz)
print("Buzz count:", buzz)
print("FizzBuzz count:", fizzbuzz)
